{
  "manifest_version": 3,
  "name": "Select to Copy",
  "version": "1.0.0",
  "description": "Copies selected text to the system clipboard automatically.",
  "permissions": ["clipboardWrite"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content.js"]
    }
  ]
}
